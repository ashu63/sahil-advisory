# ── Public ────────────────────────────────────────────────────────────────
# Set this once the real domain is live. Until then the code falls back to the
# Vercel production URL so canonicals and the sitemap point somewhere real.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_COMPANY_GSTIN=

# ── Database (Supabase Postgres) ──────────────────────────────────────────
# DATABASE_URL: transaction pooler, port 6543. Used at runtime.
#   postgresql://postgres.<ref>:<pw>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DIRECT_URL: session pooler, port 5432. Used by migrations only.
#   postgresql://postgres.<ref>:<pw>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Leave both unset and the site still runs; leads fall back to log and email.
DATABASE_URL=
DIRECT_URL=

# ── Lead notifications: email ─────────────────────────────────────────────
# Without RESEND_API_KEY, leads are only logged. Set this first.
RESEND_API_KEY=
LEADS_TO_EMAIL=sahiladvisory1@gmail.com
LEADS_FROM_EMAIL=leads@sahiladvisory.in

# ── Lead notifications: WhatsApp ──────────────────────────────────────────
# WHATSAPP_PROVIDER: "meta" (official Cloud API) or "webhook" (BSP such as
# AiSensy or Interakt, or an automation that forwards to WhatsApp).
# Unset means no WhatsApp is sent; the lead is still stored and emailed.
WHATSAPP_PROVIDER=
# The number that receives lead alerts, in international format, digits only.
WHATSAPP_NOTIFY_TO=917888412302

# provider = meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# An approved template whose body has four placeholders, in this order:
# {{1}} name, {{2}} phone, {{3}} service, {{4}} detail
WHATSAPP_TEMPLATE_NAME=new_lead
WHATSAPP_TEMPLATE_LANG=en

# provider = webhook
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# ── SEO ───────────────────────────────────────────────────────────────────
INDEXNOW_KEY=
CRON_SECRET=

# ── Later phases (unused today) ───────────────────────────────────────────
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_EMAILS=
